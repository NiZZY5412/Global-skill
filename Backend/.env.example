APP_NAME=TALVORA API
ENVIRONMENT=development
DATABASE_PATH=./talvora.db
JWT_SECRET=replace-this-with-a-long-random-production-secret
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174,http://localhost:3000,null
ADMIN_EMAIL=admin@talvora.com
ADMIN_PASSWORD=change-this-immediately
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@talvora.com
SMTP_FROM_NAME=TALVORA

# Payments: keep disabled until provider accounts, KYC/KYB and webhook URLs are configured.
DEFAULT_CURRENCY=USD
PAYMENT_MODE=disabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
BANK_PAYOUT_PROVIDER_URL=
BANK_PAYOUT_PROVIDER_KEY=
